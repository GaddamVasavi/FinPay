# FinPay Environment Configuration (Example)

# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://finpay_user:finpay_password@localhost:5432/finpay_db?schema=public"

# Redis Cache & Rate Limiting
REDIS_URL="redis://localhost:6379"

# Security & JWT Tokens
JWT_SECRET="finpay_jwt_super_secret_access_key_2026_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="finpay_jwt_super_secret_refresh_key_2026_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Sandbox Configuration (Fictional / Test Only)
PAYMENT_PROVIDER="stripe_sandbox"
PAYMENT_PUBLIC_KEY="pk_test_sample_finpay_public_key"
PAYMENT_SECRET_KEY="sk_test_sample_finpay_secret_key"
PAYMENT_WEBHOOK_SECRET="whsec_sample_finpay_webhook_secret"

# Email Configuration (SMTP Test/Mailhog)
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER="sample_smtp_user"
EMAIL_PASSWORD="sample_smtp_password"
EMAIL_FROM="FinPay Security <no-reply@finpay.local>"

# System Settings
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
DEFAULT_CURRENCY="USD"
TRANSACTION_DAILY_LIMIT=50000.00
RISK_THRESHOLD_HIGH_AMOUNT=10000.00
