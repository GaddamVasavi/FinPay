{
  "name": "finpay-backend",
  "version": "1.0.0",
  "description": "Backend API Server for FinPay Financial Management Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
